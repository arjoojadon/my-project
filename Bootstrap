  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const body = document.body;
    const themeBtn = document.getElementById('themeBtn');

    themeBtn.addEventListener('click', () => {
      body.classList.toggle('dark');
      themeBtn.innerHTML = body.classList.contains('dark')
        ? '<i class="bi bi-sun-fill"></i> Theme'
        : '<i class="bi bi-moon-fill"></i> Theme';
    });

    const form = document.getElementById('contactForm');
    const nameInput = document.getElementById('name');
    const emailInput = document.getElementById('email');
    const messageInput = document.getElementById('message');
    const successMsg = document.getElementById('successMsg');

    const nameErr = document.getElementById('nameErr');
    const emailErr = document.getElementById('emailErr');
    const msgErr = document.getElementById('msgErr');

    function showError(el) {
      el.classList.remove('hidden-msg');
    }

    function hideError(el) {
      el.classList.add('hidden-msg');
    }

    form.addEventListener('submit', function(e) {
      e.preventDefault();

      let valid = true;
      hideError(nameErr);
      hideError(emailErr);
      hideError(msgErr);
      hideError(successMsg);

      if (nameInput.value.trim() === '') {
        showError(nameErr);
        valid = false;
      }

      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailPattern.test(emailInput.value.trim())) {
        showError(emailErr);
        valid = false;
      }

      if (messageInput.value.trim() === '') {
        showError(msgErr);
        valid = false;
      }

      if (valid) {
        successMsg.classList.remove('hidden-msg');
        form.reset();
      }
    });
  </script>
